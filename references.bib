@incollection{OLIVER20243,
title = {Chapter 1 - The history and development of plant pathology},
editor = {Richard P. Oliver},
booktitle = {Agrios' Plant Pathology (Sixth Edition)},
publisher = {Academic Press},
edition = {Sixth Edition},
pages = {3-61},
year = {2024},
isbn = {978-0-12-822429-8},
doi = {https://doi.org/10.1016/B978-0-12-822429-8.00001-7},
url = {https://www.sciencedirect.com/science/article/pii/B9780128224298000017},
author = {Richard P. Oliver},
keywords = {Theophrastus, Albertus Magnus, Spontaneous generation, Thoullier, Hooke, Leeuwenhoek, Linnaeus, Darwin, Tillet, Prevost, deBary, Petri, Koch, Koch's postulates, Pasteur, Irish potato famine, Diener, Prusiner, Millardet, Bordeaux mixture, Ug99, Ash dieback, Pesticides, Fleming, Carson, Flor, Vanderplank, CGIAR, Eriksson, The profession of plant pathology},
abstract = {Plant pathology is the science that studies plant diseases. It is concerned with how pathogens cause disease and how plants resist pathogens. It describes how diseases spread in time and place. It also seeks to find methods to protect plants from the impacts of disease. Plant pathology is challenging, interesting, and important. It has a practical and noble goal of protecting the food available for humans and animals and preserving the natural environment against invasive diseases. Plant diseases, by their presence, prevent the cultivation and growth of food plants in some areas. More commonly, plants may be cultivated and grown but plant diseases attack them, destroy part or all of the plant, and reduce much of their food and fiber products, before they can be harvested or consumed; and they may, often with human help, invade new territories and damage nature.}
}
